# SUSHIJARO Telegram order notifications
#
# Configure encrypted environment variables in the Vercel cardsvc project.
# Keep the bot token secret and never put it in NEXT_PUBLIC_* values.
SUSHIJARO_TELEGRAM_BOT_TOKEN=
SUSHIJARO_TELEGRAM_CHAT_ID=
# Optional: only needed when sending into a Telegram forum group topic.
SUSHIJARO_TELEGRAM_THREAD_ID=
